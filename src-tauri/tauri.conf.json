{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SVaGier",
  "version": "0.1.0",
  "identifier": "pl.svagier.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SVaGier",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 560
      }
    ]
  },
  "bundle": {
    "active": true
  }
}
